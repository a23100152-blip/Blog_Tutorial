---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Bitácora de Aprendizaje: Astro";
---
<BaseLayout pageTitle={pageTitle}>
	<p>En esta sección voy dejando los avances y algunas notas mientras sigo el tutorial de Astro para esta práctica.</p>
	<ul>
		{allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
	</ul>
</BaseLayout>
