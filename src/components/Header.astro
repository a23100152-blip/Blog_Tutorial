---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
---
<header>
	<nav>
		<div class="menu-group">
			<ThemeIcon />
			<Menu />
		</div>
		<Navigation />
	</nav>
</header>

<style>
	.menu-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
</style>
